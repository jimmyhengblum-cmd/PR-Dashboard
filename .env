# ── GitHub ──────────────────────────────────────────
# Personal access token (scope: repo)
GITHUB_TOKEN=secret_github_token
# Comma-separated list of repos: owner/repo
GITHUB_REPOS=pernod-ricard-coe-data/pr-data-c3-digitalasset-snowflake,pernod-ricard-coe-data/pr-data-consumerinsights,pernod-ricard-coe-data/pr-data-website-analytics,pernod-ricard-coe-data/pr-data-c3-consumer-master,pernod-ricard-coe-data/pr-data-c3-digitalasset-snowflake,pernod-ricard-coe-data/pr-data-c3-consumer-anp-dbt,pernod-ricard-coe-data/pr-data-c3-marketing360-dbt

TEAM_MEMBERS=CRI, PCH, JHE, VTO, SRI, GPI, SPL
# ── Azure DevOps ───────────────────────────────────
# Personal access token (scope: Code Read)
# AZURE_DEVOPS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Organization name
# AZURE_DEVOPS_ORG=myorganization
# Comma-separated list: project/repo
# AZURE_DEVOPS_PROJECTS=MyProject/my-repo,OtherProject/other-repo

# ── App Settings ───────────────────────────────────
# Your username (for "actionable" view filtering)
# CURRENT_USER=johndoe
# Auto-refresh interval in minutes (0 = disabled)
# AUTO_REFRESH_MINUTES=5
